# ===================================================
# E2Aubooks - Cấu hình Môi trường Local & Docker
# ===================================================

# Cổng khởi chạy máy chủ web (mặc định 3000)
PORT=3000

# ---- TTS Local ----
# App tự khởi động daemon cho engine được chọn, rồi tự tắt sau
# TTS_IDLE_TIMEOUT_MS. Ba daemon chạy ở port 9980 (vieneu), 9981 (mms),
# 9982 (kokoro). Không cần chạy daemon thủ công.

# Đường dẫn tới thư mục model (mặc định ./models)
TTS_MODELS_DIR=./models

# Thời gian không dùng trước khi tự tắt daemon (5 phút)
TTS_IDLE_TIMEOUT_MS=300000

# Chỉ định khi chạy ngoài Docker. Trong image, Dockerfile đã trỏ sẵn.
# TTS_PYTHON=/usr/local/bin/python3
# TTS_DAEMON=/app/tts/tts_daemon.py
# VIENEU_SRC=/app/tts/vieneu-src

# ---- Phần cứng ----
# 'cuda' dùng VieNeu trên GPU (nhanh nhất, ~0.3s/câu)
# 'cpu'  chạy float32 trên CPU, không cần NVIDIA Container Toolkit
DEVICE=cuda

# Kiểu dữ liệu PyTorch do supervisor tự chọn: bfloat16 trên GPU (khớp
# SDK chính thức), float32 trên CPU. Không cần đặt tay.

# Số luồng CPU cho ONNX Runtime (Kokoro)
ONNX_THREADS=4
